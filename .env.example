NGROK_AUTHTOKEN=replace-me
LINE_CHANNEL_SECRET=replace-me
LINE_CHANNEL_ACCESS_TOKEN=replace-me

# Demo 預設：Google AI Studio / Gemma 4 26B A4B
AI_PROVIDER=google
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemma-4-26b-a4b-it

# 可選：若要改用 OpenAI Luna，將 AI_PROVIDER 改成 openai 並填入金鑰
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

APP_PORT=5000
APP_HOST=127.0.0.1
# Flex Message 圖片必須是 LINE 伺服器可讀的 HTTPS 網址，例如目前的 ngrok 根網址
PUBLIC_BASE_URL=
MODEL_TIMEOUT_SECONDS=5
LINE_REPLY_TIMEOUT_SECONDS=2
WEBHOOK_WORKER_THREADS=4
WEBHOOK_QUEUE_CAPACITY=4
WEBHOOK_MAX_PENDING_PER_KEY=4
MEMORY_TTL_SECONDS=1800
DEDUPE_TTL_SECONDS=600
QUIZ_TTL_SECONDS=1800
# 導引進度存在機器人伺服器，不是使用者手機；部署時保留此資料卷
LEARNING_PATH=data/private/learning.sqlite3
WEBHOOK_STORE_PATH=data/private/webhooks.sqlite3
DIRECT_MATCH_MIN_SCORE=0.46
DIRECT_MATCH_MIN_MARGIN=0.08
